---
interface Props { items: { label: string; href: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs mono" aria-label="Breadcrumb">
  <ol>
    {items.map((c, i) => (
      <li>{i < items.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
    ))}
  </ol>
</nav>
