---
/* Global consultation overlay: any [data-consult-open] link opens it with the Orb flood.
   Without JavaScript those links simply go to /consultation/. */
import Logo from './Logo.astro';
import ConsultForm from './ConsultForm.astro';
---
<div class="consult" id="consultation" role="dialog" aria-modal="true" aria-labelledby="consult-dialog-title" hidden data-consult>
  <div class="consult__flood" aria-hidden="true"></div>
  <div class="consult__inner">
    <div class="consult__head">
      <Logo variant="white" class="consult__logo" alt="Ortho Marketing" sizes="150px" />
      <p class="mono consult__kicker">Records appointment</p>
      <button class="consult__close mono" type="button" data-consult-close>Close <span aria-hidden="true">✕</span></button>
    </div>
    <ConsultForm mode="overlay" />
  </div>
</div>
<script>
  import '../scripts/consult.js';
</script>
