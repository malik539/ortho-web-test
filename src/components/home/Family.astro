---
import PortraitPlate from '../PortraitPlate.astro';
import { SITE } from '../../data/site.js';
---
<section class="studio" id="studio" data-scene="dark" aria-labelledby="studio-title">
  <div class="studio__grid wrap">
    <PortraitPlate />

    <div class="studio__text">
      <p class="eyebrow mono" data-reveal="wire"><span>Act IV</span> The family</p>
      <h2 class="d1" id="studio-title" data-reveal="lines">A family practice, <em>for family practices.</em></h2>
      <p class="lede" data-reveal="fade">
        Ortho Marketing has been family-run since {SITE.founded}. So are many of the practices we serve — parents and children,
        partners of thirty years, associates who became owners. We know what it means to build something with your
        name on it, and to protect it for the next generation.
      </p>
      <dl class="facts">
        <div><dt class="mono">Founded</dt><dd>{SITE.founded}</dd></div>
        <div><dt class="mono">Structure</dt><dd>{SITE.structure}</dd></div>
        <div><dt class="mono">{SITE.president.title}</dt><dd>{SITE.president.name} — {SITE.president.experience}</dd></div>
        <div><dt class="mono">Specialism</dt><dd>{SITE.specialism}</dd></div>
      </dl>
      <p class="studio__more"><a class="link" href="/studio/">Meet the studio <span aria-hidden="true">→</span></a></p>
    </div>
  </div>
</section>
