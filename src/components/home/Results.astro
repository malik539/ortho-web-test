---
import Compare from '../Compare.astro';
import Metrics from '../Metrics.astro';
import Quote from '../Quote.astro';
import { CASES } from '../../data/cases.js';
const c = CASES[0];
---
<section class="results" id="results" data-scene="light" aria-labelledby="results-title">
  <header class="results__head wrap">
    <p class="eyebrow mono" data-reveal="wire"><span>Act III</span> Before / After</p>
    <h2 class="d1" id="results-title" data-reveal="lines">Same practice.<br> <em>Different market.</em></h2>
    <p class="lede" data-reveal="fade">Orthodontists trust a before-and-after more than any claim. So do we. Drag the wire — then take the radiograph.</p>
  </header>

  <Compare />

  <div class="results__proof wrap">
    <Metrics items={c.metrics} />
    <Quote text={c.quote.text} by={c.quote.by} />
  </div>
  {c.illustrative && <p class="results__note mono wrap">Illustrative case: a fictional practice with illustrative figures, shown to explain how we report results. <a href={`/results/${c.slug}/`}>Read the case file</a></p>}
</section>

