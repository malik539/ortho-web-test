---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wire from '../components/Wire.astro';
import { NAV } from '../data/site.js';
---
<BaseLayout title="Page not found" description="This page has drifted. Without retention, everything does." noindex>
  <section class="page-hero page-hero--404" data-scene="dark" aria-labelledby="page-title">
    <div class="page-hero__light" aria-hidden="true"></div>
    <span class="page-hero__num" aria-hidden="true">404</span>
    <div class="page-hero__inner wrap">
      <p class="eyebrow mono" data-reveal="wire"><span>404</span> Page not found</p>
      <h1 class="d1" id="page-title">This page has drifted. <em>Without retention, everything does.</em></h1>
      <p class="lede">The link may be old, or the page may have moved. Try one of these instead.</p>
      <ul class="notfound-links">
        {NAV.map((l) => <li><a class="link" href={l.href}>{l.label}</a></li>)}
      </ul>
      <p class="cta-row"><a class="btn btn--primary" href="/"><span>Back to the homepage</span><Wire /></a></p>
    </div>
  </section>
</BaseLayout>
