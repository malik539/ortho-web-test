# Copy to .env for local builds; set the same variables in your host's dashboard for production.

# ── Public: baked into the browser bundle at build time ─────────────────────────────
# Where the consultation form posts JSON. With the bundled Netlify function: /api/consultation
# Any absolute HTTPS endpoint that accepts JSON also works (its origin is added to the CSP).
# Unset: the form shows a demo success on localhost only, and an error elsewhere.
PUBLIC_CONSULT_ENDPOINT=/api/consultation

# Google Tag Manager container (GTM-XXXXXXX). Unset: no analytics and no consent bar.
# Set: a consent bar appears and GTM loads only after "Accept".
PUBLIC_GTM_ID=

# ── Server: the Netlify function only (never exposed to the browser) ────────────────
# Where consultation requests are forwarded: CRM workflow webhook, Zapier/Make hook, etc.
CONSULT_WEBHOOK_URL=
# Optional bearer token sent with the forwarded request.
CONSULT_WEBHOOK_TOKEN=
