{
  "$description": "Ortho Marketing — 'Light, Continuous Force' design tokens (W3C Design Tokens format). Mirrors /site/tokens.css.",
  "color": {
    "occlusion":     { "$type": "color", "$value": "#0D0C0B", "$description": "Primary dark ground. Warm, never pure black." },
    "graphite":      { "$type": "color", "$value": "#1C1A18", "$description": "Raised dark surface." },
    "smoke":         { "$type": "color", "$value": "#3A3632", "$description": "Hairlines on dark. Decorative only." },
    "nitinol":       { "$type": "color", "$value": "#A3A7A9", "$description": "Secondary text on dark. 8.06:1 on Occlusion." },
    "nitinol-dim":   { "$type": "color", "$value": "#84888A", "$description": "Tertiary text on dark. 5.46:1 on Occlusion, 4.85:1 on Graphite." },
    "porcelain":     { "$type": "color", "$value": "#F4F1EB", "$description": "BL1 — primary light ground; text on dark." },
    "enamel":        { "$type": "color", "$value": "#EAE3D5", "$description": "A1 — secondary light ground." },
    "dentin":        { "$type": "color", "$value": "#CFC3AC", "$description": "B2 — hairlines on light. Decorative only." },
    "umber":         { "$type": "color", "$value": "#5E5750", "$description": "Secondary text on light. 6.30:1 on Porcelain." },
    "ligature":      { "$type": "color", "$value": "#E2412B", "$description": "The single accent: archwire, primary CTA, active states. ≤3% of any viewport." },
    "ligature-deep": { "$type": "color", "$value": "#B5321F", "$description": "Ligature for small text on light grounds. 5.41:1 on Porcelain." },
    "radiograph":    { "$type": "color", "$value": "#9DB6C6", "$description": "Only inside radiograph (x-ray) views." },
    "category-cyan": { "$type": "color", "$value": "#19B3C4", "$description": "Appears once, as 'noise' in Act I. Never a brand color." }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["GT Sectra Display", "Fraunces", "Times New Roman", "serif"] },
      "text":    { "$type": "fontFamily", "$value": ["Söhne", "Hanken Grotesk", "Helvetica Neue", "Arial", "sans-serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["Söhne Mono", "IBM Plex Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "hero":  { "$type": "dimension", "$value": "clamp(2.5rem, 0.9rem + 8.2vw, 10.5rem)" },
      "d1":    { "$type": "dimension", "$value": "clamp(2.6rem, 1.5rem + 4.9vw, 7rem)" },
      "d2":    { "$type": "dimension", "$value": "clamp(2.1rem, 1.4rem + 3vw, 4.75rem)" },
      "d3":    { "$type": "dimension", "$value": "clamp(1.6rem, 1.25rem + 1.5vw, 2.75rem)" },
      "lede":  { "$type": "dimension", "$value": "clamp(1.15rem, 1.05rem + 0.45vw, 1.5rem)" },
      "body":  { "$type": "dimension", "$value": "clamp(1rem, 0.97rem + 0.12vw, 1.0625rem)" },
      "small": { "$type": "dimension", "$value": "0.875rem" },
      "mono":  { "$type": "dimension", "$value": "0.75rem" }
    },
    "weight": {
      "display": { "$type": "fontWeight", "$value": 300 },
      "text":    { "$type": "fontWeight", "$value": 400 },
      "strong":  { "$type": "fontWeight", "$value": 600 }
    },
    "lineHeight": {
      "display": { "$type": "number", "$value": 0.94 },
      "tight":   { "$type": "number", "$value": 1.15 },
      "body":    { "$type": "number", "$value": 1.6 }
    },
    "tracking": {
      "display": { "$type": "dimension", "$value": "-0.032em" },
      "mono":    { "$type": "dimension", "$value": "0.09em" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.5rem" },
    "6": { "$type": "dimension", "$value": "2rem" },
    "7": { "$type": "dimension", "$value": "3rem" },
    "8": { "$type": "dimension", "$value": "4rem" },
    "9": { "$type": "dimension", "$value": "6rem" },
    "10": { "$type": "dimension", "$value": "8rem" },
    "11": { "$type": "dimension", "$value": "12rem" },
    "section": { "$type": "dimension", "$value": "clamp(6rem, 4rem + 9vw, 14rem)" },
    "gutter":  { "$type": "dimension", "$value": "clamp(1rem, 0.6rem + 1.6vw, 2rem)" },
    "margin":  { "$type": "dimension", "$value": "clamp(1rem, -0.2rem + 5vw, 5rem)" },
    "max":     { "$type": "dimension", "$value": "1600px" }
  },
  "line": {
    "hair": { "$type": "dimension", "$value": "1px" },
    "wire": { "$type": "dimension", "$value": "1.5px", "$description": "The archwire. Always this weight, always Ligature." }
  },
  "motion": {
    "ease": {
      "force":   { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1], "$description": "Default. Long, inevitable settle." },
      "settle":  { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1], "$description": "Repositioning, scroll-scrubbed sequences." },
      "release": { "$type": "cubicBezier", "$value": [0.3, 0, 0.8, 0.15], "$description": "Exits only." },
      "debond":  { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1], "$description": "The one overshoot on the site. Finale only." }
    },
    "duration": {
      "instant":   { "$type": "duration", "$value": "120ms" },
      "quick":     { "$type": "duration", "$value": "240ms" },
      "measured":  { "$type": "duration", "$value": "600ms" },
      "force":     { "$type": "duration", "$value": "1400ms" },
      "treatment": { "$type": "duration", "$value": "2400ms" }
    },
    "stagger": {
      "block": { "$type": "duration", "$value": "55ms" },
      "glyph": { "$type": "duration", "$value": "18ms" }
    },
    "align": {
      "offsetX":  { "$type": "dimension", "$value": "-14px" },
      "offsetY":  { "$type": "dimension", "$value": "18px" },
      "rotation": { "$type": "number", "$value": -2.2, "$description": "Degrees. Alternates with +1.4° between siblings." }
    }
  }
}
