{
  "name": "ortho-marketing-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ortho Marketing — production website (Astro, static output).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/headers.mjs",
    "preview": "astro preview --port 4321",
    "lint": "eslint --max-warnings 0 src/scripts tests scripts netlify",
    "fonts": "node scripts/copy-fonts.mjs",
    "assets": "python3 scripts/assets.py",
    "og": "node scripts/og.mjs",
    "headers": "node scripts/headers.mjs",
    "test:deploy": "PUBLIC_CONSULT_ENDPOINT=/api/consultation PUBLIC_GTM_ID=GTM-TEST000 npm run build && node tests/deploy-check.cjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "axe-core": "4.11.0",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "html-validate": "11.16.3"
  }
}
